{
  "name": "mystery-clue-game",
  "private": true,
  "type": "module",
  "description": "A deduction game built from fair-play mystery stories: collect clues, connect them, eliminate what does not fit.",
  "scripts": {
    "test": "node --test",
    "validate": "node scripts/validate-case.js cases/silver-blaze",
    "reveal-log": "node scripts/reveal-log.js cases/silver-blaze > .cache/reveal-log.txt",
    "foreshadow-log": "node scripts/foreshadow-log.js cases/silver-blaze > .cache/foreshadow-log.txt",
    "clash-log": "node scripts/clash-log.js cases/silver-blaze > .cache/clash-log.txt",
    "validate-thoughts": "node scripts/validate-thoughts.js cases/silver-blaze",
    "action-table": "node scripts/action-table.js",
    "minimal-table": "node scripts/minimal-table.js",
    "stats": "node scripts/stats.js",
    "hints": "node scripts/hints.js"
  },
  "devDependencies": {
    "ajv": "^8.17.1"
  }
}
