{
  "description": "Reasoning constraints. Each says what follows once ALL its premises (claims and rules) are known. The player never sees these as such: a cross-out or a conclusion is accepted when the cards the player cites switch on enough of them to make the alternative impossible, by whatever route. 'by' names who in the story reasons this way.",
  "constraints": [
    {"id": "k.drugger_knew_the_dish", "label": "Opium can be tasted; only a curry hides it; bringing opium on the one night a curry is served is too great a coincidence — so the drugger knew what the supper would be, i.e. was someone at the house that evening.", "by": "holmes", "premises": ["c.curry_for_supper", "c.opium_in_remains", "r.opium_taste", "r.curry_masks", "r.no_coincidence"], "formula": {"in": ["e.opium_added.agent", ["straker", "mrs_straker", "edith_baxter", "other_lads"]]}},
    {"id": "k.drugger_chose_the_dish", "label": "Only the master and mistress could have chosen curried mutton for supper, so the drugger is Straker or his wife.", "by": "holmes", "premises": ["c.curry_for_supper", "c.opium_in_remains", "r.opium_taste", "r.curry_masks", "r.no_coincidence", "r.menu_chosen_by_household"], "formula": {"in": ["e.opium_added.agent", ["straker", "mrs_straker"]]}},
    {"id": "k.menu_choosers", "label": "Who chose the supper: the master or the mistress.", "by": "holmes", "premises": ["c.household_same_dish", "r.menu_chosen_by_household"], "formula": {"in": ["e.curry_chosen.agent", ["straker", "mrs_straker"]]}},
    {"id": "k.drugged_after_set_aside", "label": "The others ate the same dish unharmed, so the opium went into Hunter's portion after it was set aside — somewhere on its way from the house to the lad.", "by": "holmes", "premises": ["c.household_same_dish", "c.opium_in_remains", "r.same_dish_safe"], "formula": {"and": [{"not_after": ["e.portion_set_aside.time", "e.opium_added.time"]}, {"in": ["e.opium_added.place", ["straker_villa", "villa_kitchen", "moor_path", "stable_window", "stable"]]}, {"eq": ["e.portion_set_aside.object", "hunter_portion"]}, {"eq": ["e.portion_set_aside.place", "straker_villa"]}]}},
    {"id": "k.portion_set_aside_before_edith", "label": "The portion was set aside at the house before Edith carried it down at a few minutes past nine, and not before the lads came up to supper at nine.", "by": "editorial", "premises": ["c.edith_carried_supper", "c.lads_supped_at_house"], "formula": {"and": [{"before": ["e.portion_set_aside.time", "e.edith_carries_supper.time"]}, {"not_after": ["e.lads_to_supper.time", "e.portion_set_aside.time"]}]}},
    {"id": "k.straker_home_all_evening", "label": "Straker heard of the tout only by message after the lads came back: he was at the house all evening, never at the stable or on the path.", "by": "editorial", "premises": ["c.lads_returned_message", "c.straker_uneasy"], "formula": {"implies": [{"eq": ["e.opium_added.agent", "straker"]}, {"in": ["e.opium_added.place", ["straker_villa", "villa_kitchen"]]}]}},
    {"id": "k.drugged_in_house_means_before_nine_five", "label": "If the opium went in at the house, it went in before Edith carried the dish out.", "by": "editorial", "premises": ["c.edith_carried_supper"], "formula": {"implies": [{"in": ["e.opium_added.place", ["straker_villa", "villa_kitchen"]]}, {"before": ["e.opium_added.time", "e.edith_carries_supper.time"]}]}},
    {"id": "k.window_drugging_time", "label": "If the opium went in at the stable window, it was while the stranger stood there.", "by": "gregory", "premises": ["c.stranger_asked_for_tip", "c.stranger_leaning_in"], "formula": {"implies": [{"in": ["e.opium_added.place", ["stable_window", "stable"]]}, {"eq": ["e.opium_added.time", "w.mon_2110"]}]}},
    {"id": "k.drugger_took_the_horse", "label": "The guard was drugged so that the horse could be taken: the drugger and the one who took the horse are the same person.", "by": "holmes", "premises": ["c.hunter_ate_drugged", "c.stall_empty", "c.hunter_on_guard"], "formula": {"and": [{"same": ["e.opium_added.agent", "e.horse_led_out.agent"]}, {"before": ["e.hunter_eats.time", "e.horse_led_out.time"]}]}},
    {"id": "k.visitor_is_taker", "label": "'The midnight visitor' is whoever came in and took out the horse.", "by": "holmes", "premises": ["c.stall_empty", "c.stable_door_open"], "formula": {"and": [{"same": ["midnight_visitor.identity", "e.horse_led_out.agent"]}, {"same": ["e.stable_entered.agent", "e.horse_led_out.agent"]}, {"same": ["e.stable_entered.time", "e.horse_led_out.time"]}]}},
    {"id": "k.bridled_by_taker", "label": "A horse does not bridle itself: whoever led it out bridled it.", "by": "police", "premises": ["c.bridle_missing", "c.stall_empty", "r.bridle_needs_a_hand"], "formula": {"and": [{"same": ["e.horse_bridled.agent", "e.horse_led_out.agent"]}, {"same": ["e.horse_bridled.time", "e.horse_led_out.time"]}]}},
    {"id": "k.dog_knew_the_visitor", "label": "A dog was in the stable; someone came in and took out a horse; the dog did not bark enough to wake the lads. A dog barks at strangers — so the visitor was someone it knew well: someone of King's Pyland.", "by": "holmes", "premises": ["c.dog_kept_in_stable", "c.dog_did_nothing", "c.lads_heard_nothing", "c.stall_empty", "r.dog_barks_at_strangers"], "formula": {"and": [{"in": ["e.horse_led_out.agent", ["straker", "mrs_straker", "edith_baxter", "ned_hunter", "other_lads", "sheep_lad", "colonel_ross"]]}, {"same": ["e.dog_silent.time", "e.horse_led_out.time"]}]}},
    {"id": "k.hunter_was_drugged", "label": "Hunter was in a drugged stupor all night; he took nothing out.", "by": "editorial", "premises": ["c.hunter_ate_drugged", "c.hunter_stupor"], "formula": {"and": [{"ne": ["e.horse_led_out.agent", "ned_hunter"]}, {"ne": ["e.opium_added.agent", "ned_hunter"]}]}},
    {"id": "k.lads_slept", "label": "The two lads slept through the night in the loft.", "by": "editorial", "premises": ["c.lads_heard_nothing"], "formula": {"nin": ["e.horse_led_out.agent", ["other_lads", "sheep_lad"]]}},
    {"id": "k.wife_stayed_home", "label": "Mrs. Straker was at home: she saw her husband go out at one and woke at seven to find him gone.", "by": "editorial", "premises": ["c.straker_dressing_at_one", "c.wife_woke_at_seven"], "formula": {"nin": ["e.horse_led_out.agent", ["mrs_straker", "edith_baxter"]]}},
    {"id": "k.straker_went_out_first", "label": "If Straker took the horse, he did so after leaving the house at one.", "by": "holmes", "premises": ["c.straker_dressing_at_one", "c.straker_left_in_mackintosh"], "formula": {"implies": [{"eq": ["e.horse_led_out.agent", "straker"]}, {"before": ["e.straker_leaves.time", "e.horse_led_out.time"]}]}},
    {"id": "k.night_sequence", "label": "The horse was taken from the stable, then was in the hollow at the struggle, and left it afterwards along the track; Straker died after leaving home at one.", "by": "holmes", "premises": ["c.stall_empty", "c.horse_was_in_hollow", "c.body_in_hollow", "c.straker_left_in_mackintosh", "c.horse_track_in_wet_hollow"], "formula": {"and": [{"before": ["e.horse_led_out.time", "e.led_to_hollow.time"]}, {"before": ["e.led_to_hollow.time", "e.fatal_blow.time"]}, {"before": ["e.fatal_blow.time", "e.horse_bolts.time"]}, {"before": ["e.straker_leaves.time", "e.fatal_blow.time"]}, {"same": ["e.straker_dies.time", "e.fatal_blow.time"]}, {"same": ["e.thigh_cut.time", "e.fatal_blow.time"]}]}},
    {"id": "k.found_before_seven", "label": "The horse was gone and the stable open by seven; the man near Mapleton met the horse after it had left the hollow.", "by": "editorial", "premises": ["c.stable_door_open", "c.horse_alone"], "formula": {"and": [{"before": ["e.horse_led_out.time", "e.stable_found_open.time"]}, {"before": ["e.horse_bolts.time", "e.brown_finds_horse.time"]}]}},
    {"id": "k.coat_placed", "label": "There was no wind, so the coat was not blown onto the bush: it was laid there, by the man who wore it, before the blow.", "by": "holmes", "premises": ["c.coat_on_bush_seen", "c.no_wind", "r.wind_and_coats", "c.straker_left_in_mackintosh"], "formula": {"and": [{"eq": ["e.coat_off.agent", "straker"]}, {"eq": ["e.coat_off.object", "overcoat"]}, {"eq": ["e.coat_off.place", "fatal_hollow"]}, {"not_after": ["e.led_to_hollow.time", "e.coat_off.time"]}, {"before": ["e.coat_off.time", "e.fatal_blow.time"]}]}},
    {"id": "k.vesta_from_strakers_box", "label": "A wax vesta was struck in the hollow, and Straker carried a box of vestas: the match was his, struck before the blow.", "by": "holmes", "premises": ["c.vesta_in_mud", "c.pocket_inventory"], "formula": {"and": [{"eq": ["wax_vesta.owner", "straker"]}, {"same": ["e.light_struck.agent", "wax_vesta.owner"]}, {"not_after": ["e.led_to_hollow.time", "e.light_struck.time"]}, {"before": ["e.light_struck.time", "e.fatal_blow.time"]}]}},
    {"id": "k.led_by_taker", "label": "Whoever took the horse out led it to the hollow.", "by": "police", "premises": ["c.stall_empty", "c.horse_was_in_hollow"], "formula": {"same": ["e.led_to_hollow.agent", "e.horse_led_out.agent"]}},
    {"id": "k.knife_for_an_operation", "label": "A cataract knife is useless as a weapon but made for a delicate operation; Straker chose it deliberately as he went out. A slight nick on a horse's tendon leaves no trace and makes it lame. So, if Straker took the horse, it was to lame it.", "by": "holmes", "premises": ["c.knife_is_cataract_knife", "c.knife_delicate", "c.knife_from_dressing_table", "r.cataract_knife_use", "r.tendon_nick"], "formula": {"implies": [{"eq": ["e.horse_led_out.agent", "straker"]}, {"eq": ["e.horse_led_out.purpose", "injure"]}]}},
    {"id": "k.drugging_is_dishonest", "label": "Nobody drugs his own stable-boy for an honest purpose: if Straker drugged him, Straker was dishonest, and took the horse out for no honest reason.", "by": "holmes", "premises": ["c.opium_in_remains", "r.honest_men_dont_drug"], "formula": {"implies": [{"eq": ["e.opium_added.agent", "straker"]}, {"and": [{"eq": ["straker.honest", "false"]}, {"nin": ["e.horse_led_out.purpose", ["exercise"]]}]}]}},
    {"id": "k.operation_in_the_open", "label": "A pricked horse would wake the soundest sleepers, so the operation had to be done away from the stable, in a hollow where a light would not show — hence the candle and the matches.", "by": "holmes", "premises": ["r.horse_would_wake_sleepers", "r.light_hidden_in_hollow", "c.pocket_inventory"], "formula": {"implies": [{"eq": ["e.horse_led_out.purpose", "injure"]}, {"eq": ["e.led_to_hollow.place", "fatal_hollow"]}]}},
    {"id": "k.horse_kicked", "label": "Straker struck a light behind the horse in the hollow; a horse startled by a sudden glare, sensing mischief, lashes out. The head was shattered by a heavy blow, and the horse was there: the steel shoe killed him.", "by": "holmes", "premises": ["c.head_shattered", "c.horse_was_in_hollow", "c.vesta_in_mud", "r.startled_horse_kicks", "r.light_hidden_in_hollow"], "formula": {"implies": [{"eq": ["e.horse_led_out.purpose", "injure"]}, {"and": [{"eq": ["e.fatal_blow.agent", "silver_blaze"]}, {"eq": ["e.fatal_blow.instrument", "steel_shoe"]}]}]}},
    {"id": "k.blow_needs_a_wielder", "label": "A heavy stick or a riding-crop needs a hand to swing it; a horse's shoe strikes only as the horse kicks.", "by": "editorial", "premises": ["c.head_shattered"], "formula": {"and": [{"implies": [{"eq": ["e.fatal_blow.instrument", "steel_shoe"]}, {"eq": ["e.fatal_blow.agent", "silver_blaze"]}]}, {"implies": [{"eq": ["e.fatal_blow.agent", "silver_blaze"]}, {"eq": ["e.fatal_blow.instrument", "steel_shoe"]}]}, {"implies": [{"eq": ["e.fatal_blow.instrument", "penang_lawyer"]}, {"same": ["e.fatal_blow.agent", "penang_lawyer.owner"]}]}, {"ne": ["e.fatal_blow.instrument", "horseshoe"]}, {"ne": ["e.fatal_blow.instrument", "hunting_crop"]}]}},
    {"id": "k.only_one_blade", "label": "Simpson had no knife and no other blade was found; Straker's own knife was bloody to the handle: the cut on his thigh was his own knife, as he fell.", "by": "watson", "premises": ["c.simpson_no_knife", "c.knife_in_right_hand", "c.thigh_cut", "r.convulsions_after_brain_injury"], "formula": {"and": [{"eq": ["e.thigh_cut.instrument", "cataract_knife"]}, {"eq": ["e.thigh_cut.agent", "straker"]}]}},
    {"id": "k.knife_marks_assailant", "label": "If Straker's knife had cut an assailant, that man would bear a wound; Simpson has none.", "by": "holmes", "premises": ["c.knife_in_right_hand", "c.simpson_no_wound", "r.knife_marks_assailant"], "formula": {"implies": [{"eq": ["e.fatal_blow.agent", "simpson"]}, {"eq": ["e.thigh_cut.agent", "straker"]}]}},
    {"id": "k.cravat_order", "label": "The cravat was dropped before Straker came to hold it, and he held it before he died, after leaving home.", "by": "holmes", "premises": ["c.cravat_in_left_hand", "c.simpson_owns_cravat"], "formula": {"and": [{"same": ["e.cravat_dropped.agent", "cravat.owner"]}, {"not_after": ["e.cravat_dropped.time", "e.cravat_picked_up.time"]}, {"before": ["e.cravat_picked_up.time", "e.fatal_blow.time"]}, {"not_after": ["e.straker_leaves.time", "e.cravat_picked_up.time"]}, {"eq": ["e.cravat_dropped.object", "cravat"]}, {"eq": ["e.cravat_picked_up.object", "cravat"]}]}},
    {"id": "k.cravat_worn_at_window", "label": "The stranger was wearing the cravat when the maid saw him at the stable, so he lost it no earlier than that.", "by": "editorial", "premises": ["c.edith_knows_cravat", "c.stranger_leaning_in"], "formula": {"not_after": [{"lit": "w.mon_2110"}, "e.cravat_dropped.time"]}},
    {"id": "k.simpson_purpose", "label": "Simpson came either for information, or to drug the guard, or to steal the horse; each of the last two would make him the drugger or the thief.", "by": "police", "premises": ["c.simpson_admits_visit"], "formula": {"and": [{"implies": [{"eq": ["simpson.purpose", "nobble_horse"]}, {"eq": ["e.opium_added.agent", "simpson"]}]}, {"implies": [{"eq": ["simpson.purpose", "steal_horse"]}, {"eq": ["e.horse_led_out.agent", "simpson"]}]}]}},
    {"id": "k.paper_held_opium_means_nobbling", "label": "Had the folded paper held opium, his purpose was to drug the boy.", "by": "police", "premises": ["c.bribe_to_edith", "c.paper_in_hand"], "formula": {"implies": [{"eq": ["paper_packet.contents", "opium"]}, {"eq": ["simpson.purpose", "nobble_horse"]}]}},
    {"id": "k.bill_is_his_own", "label": "Men do not carry other people's bills: the milliner's account in Straker's pocket was his own.", "by": "holmes", "premises": ["c.milliner_bill", "c.papers_in_pocket", "r.others_bills"], "formula": {"eq": ["milliner_bill.owner", "straker"]}},
    {"id": "k.bill_names_its_debtor", "label": "The account is made out to William Derbyshire: whoever really owes it is 'Derbyshire'.", "by": "holmes", "premises": ["c.milliner_bill"], "formula": {"same": ["milliner_bill.owner", "william_derbyshire.identity"]}},
    {"id": "k.second_household", "label": "A trainer's wages do not buy twenty-guinea dresses, and his wife never had one: Straker was keeping a second establishment as 'Derbyshire', and its cost drove him.", "by": "holmes", "premises": ["c.bill_22_guineas", "c.wife_never_had_dress", "r.servant_wages", "r.laying_against"], "formula": {"implies": [{"eq": ["william_derbyshire.identity", "straker"]}, {"and": [{"eq": ["e.second_household.agent", "straker"]}, {"eq": ["e.second_household.place", "derbyshire_household"]}, {"eq": ["e.straker_in_debt.patient", "straker"]}, {"eq": ["straker.motive", "debts_of_second_household"]}, {"not_after": ["e.second_household.time", "e.dresses_bought.time"]}]}]}},
    {"id": "k.dresses_for_the_other_woman", "label": "The dresses were bought for a woman who is neither the wife nor anyone else in the household.", "by": "holmes", "premises": ["c.wife_never_had_dress", "c.bill_22_guineas", "r.servant_wages"], "formula": {"nin": ["e.dresses_bought.recipient", ["mrs_straker", "edith_baxter"]]}},
    {"id": "k.practice_first", "label": "So delicate an operation is not attempted without practice; three of the paddock sheep have lately gone lame: Straker practised on them. The lameness is recent ('of late').", "by": "holmes", "premises": ["c.sheep_lame", "r.practise_first", "r.tendon_nick"], "formula": {"implies": [{"eq": ["e.horse_led_out.purpose", "injure"]}, {"and": [{"same": ["e.practice_on_sheep.agent", "e.horse_led_out.agent"]}, {"eq": ["e.practice_on_sheep.patient", "lame_sheep"]}, {"eq": ["e.practice_on_sheep.place", "paddock"]}, {"in": ["e.practice_on_sheep.time", ["w.weeks_before", "w.mon_day"]]}]}]}},
    {"id": "k.lame_plan", "label": "Whoever took the horse out to lame it had plotted to lame it beforehand.", "by": "holmes", "premises": ["r.tendon_nick", "r.laying_against"], "formula": {"implies": [{"eq": ["e.horse_led_out.purpose", "injure"]}, {"and": [{"same": ["e.plot_to_lame.agent", "e.horse_led_out.agent"]}, {"eq": ["e.plot_to_lame.patient", "silver_blaze"]}, {"same": ["e.lays_against.agent", "e.horse_led_out.agent"]}, {"not_after": ["e.plot_to_lame.time", "e.practice_on_sheep.time"]}, {"before": ["e.lays_against.time", {"lit": "w.tue_0100"}]}]}]}},
    {"id": "k.horse_goes_home", "label": "A loose horse goes back to its own stable or to the nearest other one; gypsies would not take it, for they flee trouble and could never sell it. It is not at King's Pyland: so it went to Mapleton.", "by": "holmes", "premises": ["r.horse_gregarious", "r.gypsies_avoid_trouble", "r.famous_horse_unsellable", "c.gypsies_gone", "c.no_news_of_horse"], "formula": {"in": ["silver_blaze.hidden_at", ["kings_pyland", "mapleton"]]}},
    {"id": "k.tracks_end_at_mapleton", "label": "The horse's track, with a man's beside it, ends at the Mapleton gates: the horse is there.", "by": "holmes", "premises": ["c.horse_track_in_wet_hollow", "c.double_track_loops"], "formula": {"and": [{"eq": ["silver_blaze.hidden_at", "mapleton"]}, {"eq": ["e.horse_hidden.place", "mapleton"]}]}},
    {"id": "k.boots_identify", "label": "The square-toed prints match Silas Brown's own boots: he is the man.", "by": "holmes", "premises": ["c.square_toes", "r.prints_identify_boots"], "formula": {"same": ["track_man.identity", "brown_boots.owner"]}},
    {"id": "k.first_up_and_no_subordinate", "label": "Brown is always first up, and no subordinate would dare: if the horse went into Mapleton at dawn, it was Brown who took it in.", "by": "holmes", "premises": ["c.brown_first_up", "c.no_subordinate", "c.dawson_fears_master"], "formula": {"implies": [{"eq": ["e.horse_hidden.place", "mapleton"]}, {"eq": ["e.horse_hidden.agent", "silas_brown"]}]}},
    {"id": "k.brown_broke", "label": "Brown gave in to Holmes: 'Your instructions will be done … It shall be there.' He has the horse.", "by": "watson", "premises": ["c.brown_capitulates"], "formula": {"eq": ["e.horse_hidden.agent", "silas_brown"]}},
    {"id": "k.found_at_dawn", "label": "Brown is always first stirring: he met the loose horse at dawn, and led it in then.", "by": "holmes", "premises": ["c.brown_first_up", "c.horse_alone"], "formula": {"and": [{"eq": ["e.brown_finds_horse.time", "w.tue_dawn"]}, {"eq": ["e.brown_turns_back.time", "w.tue_dawn"]}, {"eq": ["e.horse_hidden.time", "w.tue_dawn"]}]}},
    {"id": "k.disguised_to_survive_search", "label": "The police searched Mapleton and found nothing, though the horse was there and 'a child would know' him: his markings must have been hidden — a horse-faker's trick.", "by": "holmes", "premises": ["c.mapleton_searched_nothing", "c.silver_blaze_markings", "r.disguise_washes_off"], "formula": {"implies": [{"eq": ["silver_blaze.hidden_at", "mapleton"]}, {"and": [{"eq": ["silver_blaze.disguised", "true"]}, {"same": ["e.horse_disguised.agent", "e.horse_hidden.agent"]}, {"eq": ["e.horse_disguised.patient", "silver_blaze"]}, {"eq": ["e.horse_disguised.instrument", "disguise_dye"]}, {"eq": ["e.horse_disguised.place", "mapleton"]}]}]}},
    {"id": "k.markings_identify", "label": "Silver Blaze has a white forehead and a mottled leg; the bay has not a white hair — so, unless the markings are hidden, the bay is not Silver Blaze.", "by": "colonel_ross", "premises": ["c.silver_blaze_markings", "c.bay_no_white", "r.markings_identify_horse"], "formula": {"implies": [{"eq": ["silver_blaze.disguised", "false"]}, {"ne": ["the_bay.identity", "silver_blaze"]}]}},
    {"id": "k.bay_is_ross_entry", "label": "The bay carries Ross's colours; all six numbers are up, Bayard is scratched, and no other Ross horse is entered: the bay is Ross's runner, Silver Blaze.", "by": "holmes", "premises": ["c.bay_in_ross_colours", "c.race_card", "c.all_six_there", "c.bayard_scratched", "r.colours_identify_owner"], "formula": {"eq": ["the_bay.identity", "silver_blaze"]}},
    {"id": "k.sent_over_by_hider", "label": "The horse came to the course from whoever was hiding it.", "by": "holmes", "premises": ["c.found_with_faker", "c.brown_capitulates"], "formula": {"same": ["e.horse_sent_over.agent", "e.horse_hidden.agent"]}},
    {"id": "k.went_out_to_the_stables", "label": "If Straker took the horse, he picked up his knife as he left and went down to the stable.", "by": "editorial", "premises": ["c.straker_dressing_at_one", "c.knife_from_dressing_table"], "formula": {"implies": [{"eq": ["e.horse_led_out.agent", "straker"]}, {"eq": ["e.stable_entered.agent", "straker"]}]}}
  ]
}
