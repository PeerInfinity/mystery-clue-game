{
  "description": "Inferences: reasoning written into the case. Each rests on premises (clues and background facts) and has a formula. The player builds an inference by connecting its premises, or hears a character state it (`stated`: who, and the quote where), or (Trivial) is given it once its premises are known; a held inference counts like a trusted clue until doubted. `truth: false` marks a character's wrong reasoning: the case reads it doubted, so its truth comes out false. Holmes's are also stated where the story tells the route step that needs them (worked out, not listed here).",
  "constraints": [
    {"id": "k.drugger_knew_the_dish", "label": "Opium can be tasted; only a curry hides it; bringing opium on the one night a curry is served is too great a coincidence — so the drugger knew what the supper would be, and only the people of the house's own establishment knew that: the drugger was one of the King's Pyland people.", "by": "holmes", "premises": ["c.curry_for_supper", "c.opium_in_remains", "c.opium_in_portion_only", "c.straker_household", "c.household_same_dish", "r.menu_known_at_home", "r.opium_taste", "r.curry_masks", "r.no_coincidence"], "formula": {"eq": [{"rel": ["of_establishment", "e.opium_added.agent"]}, "kings_pyland"]}, "rules": [{"rule": "r.opium_taste", "bind": {"dosing": "e.opium_added"}}, {"rule": "r.curry_masks", "bind": {"dish": "curried_mutton"}}, {"rule": "r.no_coincidence", "bind": {"dosing": "e.opium_added", "portion": "hunter_portion", "dish": "curried_mutton", "choosing": "e.curry_chosen", "house": "straker_villa"}}, {"rule": "r.menu_known_at_home", "bind": {"house": "straker_villa"}}]},
    {"id": "k.drugger_chose_the_dish", "label": "A drug that had to be hidden, brought on the one night a dish that hides it was served: the drugger arranged the dish, and only the master and mistress choose supper. So the drugger is Straker or his wife.", "by": "holmes", "premises": ["c.curry_for_supper", "c.opium_in_remains", "c.opium_in_portion_only", "c.household_same_dish", "c.straker_household", "r.opium_taste", "r.curry_masks", "r.planned_the_dish"], "formula": {"in": ["e.opium_added.agent", ["straker", "mrs_straker"]]}, "rules": [{"rule": "r.opium_taste", "bind": {"dosing": "e.opium_added"}}, {"rule": "r.curry_masks", "bind": {"dish": "curried_mutton"}}, {"rule": "r.planned_the_dish", "bind": {"dosing": "e.opium_added", "portion": "hunter_portion", "dish": "curried_mutton", "choosing": "e.curry_chosen", "house": "straker_villa"}}]},
    {"id": "k.menu_choosers", "label": "Who chose the supper: the master or the mistress.", "by": "holmes", "premises": ["c.household_same_dish", "c.straker_household", "r.menu_chosen_by_household"], "formula": {"in": ["e.curry_chosen.agent", ["straker", "mrs_straker"]]}, "rules": [{"rule": "r.menu_chosen_by_household", "bind": {"choosing": "e.curry_chosen", "house": "straker_villa"}}]},
    {"id": "k.drugged_after_set_aside", "label": "The others ate the same dish unharmed, so the opium went into Hunter's portion after it was set aside at the house at supper.", "by": "holmes", "premises": ["c.household_same_dish", "c.curry_for_supper", "c.lads_supped_at_house", "c.opium_in_remains", "c.opium_in_portion_only", "r.set_aside_at_the_meal", "r.same_dish_safe"], "formula": {"and": [{"not_after": ["e.portion_set_aside.time", "e.opium_added.time"]}, {"eq": ["e.portion_set_aside.object", "hunter_portion"]}, {"eq": ["e.portion_set_aside.place", "straker_villa"]}]}, "rules": [{"rule": "r.set_aside_at_the_meal", "bind": {"setting": "e.portion_set_aside", "meal": "e.household_sups", "portion": "hunter_portion", "dish": "curried_mutton"}}, {"rule": "r.same_dish_safe", "bind": {"dosing": "e.opium_added", "portion": "hunter_portion", "dish": "curried_mutton", "setting": "e.portion_set_aside", "meal": "e.household_sups"}}]},
    {"id": "k.portion_set_aside_before_edith", "label": "The portion was set aside at the house at supper, at nine, before Edith carried it down a few minutes later.", "by": "editorial", "premises": ["c.edith_carried_supper", "c.household_same_dish", "c.curry_for_supper", "c.lads_supped_at_house", "r.set_aside_at_the_meal"], "formula": {"and": [{"before": ["e.portion_set_aside.time", "e.edith_carries_supper.time"]}, {"not_after": ["e.lads_to_supper.time", "e.portion_set_aside.time"]}]}, "rules": [{"rule": "r.set_aside_at_the_meal", "bind": {"setting": "e.portion_set_aside", "meal": "e.household_sups", "portion": "hunter_portion", "dish": "curried_mutton"}}]},
    {"id": "k.straker_home_all_evening", "label": "Straker heard of the tout only by message after the lads came back: he was at the house all evening, never at the stable or on the path.", "by": "editorial", "premises": ["c.lads_returned_message", "c.straker_uneasy"], "formula": {"implies": [{"eq": ["e.opium_added.agent", "straker"]}, {"in": ["e.opium_added.place", ["straker_villa", "villa_kitchen"]]}]}, "asserted": "The story never places Straker between nine and the message that reached him at the house later in the evening; that he was at home all evening is the editorial reading of it."},
    {"id": "k.drugged_in_house_means_before_nine_five", "label": "If the opium went in at the house, it went in before Edith carried the dish out.", "by": "editorial", "premises": ["c.edith_carried_supper", "c.household_same_dish", "c.curry_for_supper", "c.lads_supped_at_house", "c.opium_in_portion_only", "r.set_aside_at_the_meal", "r.dosed_before_carried_off"], "formula": {"implies": [{"in": ["e.opium_added.place", ["straker_villa", "villa_kitchen"]]}, {"before": ["e.opium_added.time", "e.edith_carries_supper.time"]}]}, "rules": [{"rule": "r.set_aside_at_the_meal", "bind": {"setting": "e.portion_set_aside", "meal": "e.household_sups", "portion": "hunter_portion", "dish": "curried_mutton"}}, {"rule": "r.dosed_before_carried_off", "bind": {"dosing": "e.opium_added", "keeping": "e.portion_set_aside", "carrying": "e.edith_carries_supper"}}], "asserted": "The rule reaches the villa; the kitchen is a place card of its own (the lads supped there) and the portion was set aside at the villa. Open: fold the kitchen into the villa as the drugging's place."},
    {"id": "k.window_drugging_time", "label": "If the opium went in at the stable window, it was while the stranger stood there.", "by": "gregory", "premises": ["c.stranger_asked_for_tip", "c.stranger_leaning_in"], "formula": {"implies": [{"in": ["e.opium_added.place", ["stable_window", "stable"]]}, {"eq": ["e.opium_added.time", "w.mon_2110"]}]}, "asserted": "Gregory's conditional: its only support is that the stranger stood at the window at ten past nine; nothing says the dish could not have been reached there later."},
    {"id": "k.drugger_took_the_horse", "label": "The guard was drugged so that the horse could be taken: the drugger and the one who took the horse are the same person, and the horse went after the lad had eaten — after he was last seen about his duties, sending word of the tout.", "by": "holmes", "premises": ["c.hunter_ate_drugged", "c.stall_empty", "c.hunter_on_guard", "c.lads_returned_message", "c.opium_in_portion_only", "r.drugged_guard"], "formula": {"and": [{"same": ["e.opium_added.agent", "e.horse_led_out.agent"]}, {"before": ["e.hunter_eats.time", "e.horse_led_out.time"]}, {"before": ["e.message_to_straker.time", "e.horse_led_out.time"]}]}, "rules": [{"rule": "r.drugged_guard", "bind": {"dosing": "e.opium_added", "eating": "e.hunter_eats", "guard": "e.hunter_on_guard", "duty": "e.message_to_straker", "taking": "e.horse_led_out"}}]},
    {"id": "k.visitor_is_taker", "label": "'The midnight visitor' is whoever came in and took out the horse.", "by": "holmes", "premises": ["c.stall_empty", "c.stable_door_open"], "formula": {"and": [{"same": ["midnight_visitor.identity", "e.horse_led_out.agent"]}, {"same": ["e.stable_entered.agent", "e.horse_led_out.agent"]}, {"same": ["e.stable_entered.time", "e.horse_led_out.time"]}]}},
    {"id": "k.bridled_by_taker", "label": "A horse does not bridle itself: whoever led it out bridled it.", "by": "police", "premises": ["c.bridle_missing", "c.stall_empty", "r.bridle_needs_a_hand"], "formula": {"and": [{"same": ["e.horse_bridled.agent", "e.horse_led_out.agent"]}, {"same": ["e.horse_bridled.time", "e.horse_led_out.time"]}]}, "stated": [{"by": "police", "source": ["His bridle is missing, so that Simpson must have put this on"]}]},
    {"id": "k.dog_knew_the_visitor", "label": "A dog was in the stable; someone came in while it was there; the dog did not bark enough to wake the lads. A dog barks at strangers — so whoever came in was someone it knew well: someone of King's Pyland.", "by": "holmes", "premises": ["c.dog_kept_in_stable", "c.dog_did_nothing", "c.stall_empty", "c.stable_door_open", "r.dog_knows_its_own", "r.dog_barks_at_strangers"], "formula": {"eq": [{"rel": ["of_establishment", "e.stable_entered.agent"]}, "kings_pyland"]}, "rules": [{"rule": "r.dog_barks_at_strangers", "bind": {"dog": "stable_dog", "visit": "e.stable_entered", "silence": "e.dog_silent"}}, {"rule": "r.dog_knows_its_own", "bind": {"dog": "stable_dog"}}]},
    {"id": "k.hunter_was_drugged", "label": "Hunter was in a drugged stupor from his supper until he came round on Tuesday; the horse went in between: he took nothing out, and so did not drug himself either.", "by": "editorial", "premises": ["c.hunter_ate_drugged", "c.hunter_stupor", "c.hunter_knows_cravat", "c.stall_empty", "c.hunter_on_guard", "c.lads_returned_message", "c.opium_in_portion_only", "c.stable_door_open", "r.drugged_guard", "r.gone_before_found", "r.stupor_is_helpless"], "formula": {"and": [{"ne": ["e.horse_led_out.agent", "ned_hunter"]}, {"ne": ["e.opium_added.agent", "ned_hunter"]}]}, "rules": [{"rule": "r.drugged_guard", "bind": {"dosing": "e.opium_added", "eating": "e.hunter_eats", "guard": "e.hunter_on_guard", "duty": "e.message_to_straker", "taking": "e.horse_led_out"}}, {"rule": "r.gone_before_found", "bind": {"taking": "e.horse_led_out", "finding": "e.stable_found_open"}}, {"rule": "r.stupor_is_helpless", "bind": {"man": "ned_hunter", "eating": "e.hunter_eats", "recovery": "e.hunter_recovers", "doing": "e.horse_led_out"}}]},
    {"id": "k.lads_slept", "label": "The two lads came back to the stable late in the evening and were roused in the loft at seven; the horse went in between: they slept through it.", "by": "editorial", "premises": ["c.lads_heard_nothing", "c.lads_returned_message", "c.hunter_ate_drugged", "c.stall_empty", "c.hunter_on_guard", "c.opium_in_portion_only", "c.stable_door_open", "r.drugged_guard", "r.gone_before_found", "r.sleeper_stays_put"], "formula": {"ne": ["e.horse_led_out.agent", "other_lads"]}, "rules": [{"rule": "r.drugged_guard", "bind": {"dosing": "e.opium_added", "eating": "e.hunter_eats", "guard": "e.hunter_on_guard", "duty": "e.message_to_straker", "taking": "e.horse_led_out"}}, {"rule": "r.gone_before_found", "bind": {"taking": "e.horse_led_out", "finding": "e.stable_found_open"}}, {"rule": "r.sleeper_stays_put", "bind": {"sleeper": "other_lads", "retiring": "e.lads_return", "waking": "e.lads_roused", "doing": "e.horse_led_out"}}]},
    {"id": "k.wife_stayed_home", "label": "Mrs. Straker was at home: she was in bed at one, when she saw her husband go out, and woke there at seven to find him gone; the horse went in between.", "by": "editorial", "premises": ["c.straker_dressing_at_one", "c.wife_woke_at_seven", "c.hunter_ate_drugged", "c.stall_empty", "c.hunter_on_guard", "c.lads_returned_message", "c.opium_in_portion_only", "c.stable_door_open", "r.drugged_guard", "r.gone_before_found", "r.sleeper_stays_put"], "formula": {"ne": ["e.horse_led_out.agent", "mrs_straker"]}, "rules": [{"rule": "r.drugged_guard", "bind": {"dosing": "e.opium_added", "eating": "e.hunter_eats", "guard": "e.hunter_on_guard", "duty": "e.message_to_straker", "taking": "e.horse_led_out"}}, {"rule": "r.gone_before_found", "bind": {"taking": "e.horse_led_out", "finding": "e.stable_found_open"}}, {"rule": "r.sleeper_stays_put", "bind": {"sleeper": "mrs_straker", "retiring": "e.straker_dresses", "waking": "e.wife_wakes", "doing": "e.horse_led_out"}}]},
    {"id": "k.straker_went_out_first", "label": "The horse went after Hunter was last seen about his duties, and Straker was in his bedroom at one: if Straker took the horse, he did so after leaving the house at one.", "by": "holmes", "premises": ["c.straker_dressing_at_one", "c.straker_left_in_mackintosh", "c.hunter_ate_drugged", "c.stall_empty", "c.hunter_on_guard", "c.lads_returned_message", "c.opium_in_portion_only", "r.drugged_guard", "r.one_place_at_a_time"], "formula": {"implies": [{"eq": ["e.horse_led_out.agent", "straker"]}, {"before": ["e.straker_leaves.time", "e.horse_led_out.time"]}]}, "rules": [{"rule": "r.drugged_guard", "bind": {"dosing": "e.opium_added", "eating": "e.hunter_eats", "guard": "e.hunter_on_guard", "duty": "e.message_to_straker", "taking": "e.horse_led_out"}}, {"rule": "r.one_place_at_a_time", "bind": {"here": "e.straker_dresses", "there": "e.horse_led_out"}}]},
    {"id": "k.night_sequence", "label": "The horse was taken from the stable, then was in the hollow at the struggle, and left it afterwards along the track; Straker, who left home at one, died there of the blow that shattered his head, and the cut on his thigh came at the same time.", "by": "holmes", "premises": ["c.stall_empty", "c.horse_was_in_hollow", "c.body_in_hollow", "c.straker_left_in_mackintosh", "c.horse_track_in_wet_hollow", "c.horse_alone", "c.head_shattered", "c.thigh_cut", "r.leaves_before_arriving", "r.blow_is_the_death"], "formula": {"and": [{"before": ["e.horse_led_out.time", "e.led_to_hollow.time"]}, {"not_after": ["e.led_to_hollow.time", "e.fatal_blow.time"]}, {"before": ["e.fatal_blow.time", "e.horse_bolts.time"]}, {"before": ["e.straker_leaves.time", "e.fatal_blow.time"]}, {"same": ["e.straker_dies.time", "e.fatal_blow.time"]}, {"same": ["e.thigh_cut.time", "e.fatal_blow.time"]}]}, "rules": [{"rule": "r.leaves_before_arriving", "bind": {"taking": "e.horse_led_out", "arrival": "e.led_to_hollow"}}, {"rule": "r.blow_is_the_death", "bind": {"blow": "e.fatal_blow", "death": "e.straker_dies"}}]},
    {"id": "k.found_before_seven", "label": "The horse was gone and the stable open by seven; the man near Mapleton met the horse after it had left the hollow.", "by": "editorial", "premises": ["c.stable_door_open", "c.stall_empty", "c.horse_alone", "r.gone_before_found"], "formula": {"and": [{"before": ["e.horse_led_out.time", "e.stable_found_open.time"]}, {"before": ["e.horse_bolts.time", "e.brown_finds_horse.time"]}]}, "rules": [{"rule": "r.gone_before_found", "bind": {"taking": "e.horse_led_out", "finding": "e.stable_found_open"}}]},
    {"id": "k.coat_placed", "label": "There was no wind, so the coat was not blown onto the bush: it was laid there by the man who wore it out, after he left the house and before the blow.", "by": "holmes", "premises": ["c.coat_on_bush_seen", "c.no_wind", "c.straker_left_in_mackintosh", "c.head_shattered", "r.wind_and_coats", "r.dead_men_do_nothing"], "formula": {"and": [{"eq": ["e.coat_off.agent", "straker"]}, {"eq": ["e.coat_off.object", "overcoat"]}, {"eq": ["e.coat_off.place", "fatal_hollow"]}, {"before": ["e.straker_leaves.time", "e.coat_off.time"]}, {"before": ["e.coat_off.time", "e.fatal_blow.time"]}]}, "rules": [{"rule": "r.wind_and_coats", "bind": {"coat": "overcoat", "placing": "e.coat_off", "wearing": "e.straker_leaves"}}, {"rule": "r.dead_men_do_nothing", "bind": {"death": "e.fatal_blow", "doing": "e.coat_off"}}]},
    {"id": "k.vesta_from_strakers_box", "label": "A wax vesta was struck in the hollow where Straker lay, and he carried a box of vestas: the match was his, and he struck it before the blow.", "by": "holmes", "premises": ["c.vesta_in_mud", "c.pocket_inventory", "c.head_shattered", "r.vesta_from_box", "r.dead_men_do_nothing"], "formula": {"and": [{"eq": ["wax_vesta.owner", "straker"]}, {"same": ["e.light_struck.agent", "wax_vesta.owner"]}, {"before": ["e.light_struck.time", "e.fatal_blow.time"]}]}, "rules": [{"rule": "r.vesta_from_box", "bind": {"match": "wax_vesta", "box": "vesta_box", "striking": "e.light_struck", "death": "e.fatal_blow"}}, {"rule": "r.dead_men_do_nothing", "bind": {"death": "e.fatal_blow", "doing": "e.light_struck"}}]},
    {"id": "k.hollow_order", "label": "The coat came off and the light was struck in the hollow: if the man who did those things was the one who brought the horse there, he did them no earlier than he came.", "by": "holmes", "premises": ["c.horse_was_in_hollow", "c.coat_on_bush_seen", "c.vesta_in_mud", "r.acts_after_arriving"], "formula": {"and": [{"implies": [{"same": ["e.led_to_hollow.agent", "e.coat_off.agent"]}, {"not_after": ["e.led_to_hollow.time", "e.coat_off.time"]}]}, {"implies": [{"same": ["e.led_to_hollow.agent", "e.light_struck.agent"]}, {"not_after": ["e.led_to_hollow.time", "e.light_struck.time"]}]}]}, "rules": [{"rule": "r.acts_after_arriving", "bind": {"arrival": "e.led_to_hollow", "doing": "e.coat_off"}}, {"rule": "r.acts_after_arriving", "bind": {"arrival": "e.led_to_hollow", "doing": "e.light_struck"}}], "stated": [{"by": "holmes", "source": ["Once in the hollow, he had got behind the horse"]}]},
    {"id": "k.led_by_taker", "label": "Whoever took the horse out led it to the hollow.", "by": "police", "premises": ["c.stall_empty", "c.horse_was_in_hollow", "r.taker_leads_on"], "formula": {"same": ["e.led_to_hollow.agent", "e.horse_led_out.agent"]}, "stated": [{"by": "police", "source": ["he was leading the horse away over the moor"]}], "rules": [{"rule": "r.taker_leads_on", "bind": {"taking": "e.horse_led_out", "leading": "e.led_to_hollow"}}]},
    {"id": "k.knife_for_an_operation", "label": "A cataract knife is useless as a weapon but made for a delicate operation; Straker chose it deliberately as he went out. A slight nick on a horse's tendon leaves no trace and makes it lame. So, if Straker took the horse, it was to lame it.", "by": "holmes", "premises": ["c.knife_is_cataract_knife", "c.knife_delicate", "c.knife_from_dressing_table", "r.cataract_knife_use", "r.tendon_nick"], "formula": {"implies": [{"eq": ["e.horse_led_out.agent", "straker"]}, {"eq": ["e.horse_led_out.purpose", "injure"]}]}, "rules": [{"rule": "r.cataract_knife_use", "bind": {"knife": "cataract_knife", "taking": "e.knife_taken", "outing": "e.horse_led_out"}}]},
    {"id": "k.drugging_is_dishonest", "label": "Nobody drugs his own stable-boy for an honest purpose: if Straker drugged him, Straker was dishonest, and took the horse out for no honest reason.", "by": "holmes", "premises": ["c.opium_in_remains", "c.hunter_ate_drugged", "c.stall_empty", "c.hunter_on_guard", "c.lads_returned_message", "c.opium_in_portion_only", "r.honest_men_dont_drug", "r.drugged_guard"], "formula": {"implies": [{"eq": ["e.opium_added.agent", "straker"]}, {"and": [{"eq": ["straker.honest", "false"]}, {"nin": ["e.horse_led_out.purpose", ["exercise"]]}]}]}, "rules": [{"rule": "r.honest_men_dont_drug", "bind": {"dosing": "e.opium_added", "man": "straker", "outing": "e.horse_led_out"}}, {"rule": "r.drugged_guard", "bind": {"dosing": "e.opium_added", "eating": "e.hunter_eats", "guard": "e.hunter_on_guard", "duty": "e.message_to_straker", "taking": "e.horse_led_out"}}]},
    {"id": "k.operation_in_the_open", "label": "A pricked horse would wake the soundest sleepers, so the operation had to be done away from the stable, somewhere a light would not show — hence the candle and the matches.", "by": "holmes", "premises": ["r.horse_would_wake_sleepers", "r.light_hidden_in_hollow", "c.pocket_inventory", "c.hunter_on_guard", "c.stall_empty"], "formula": {"implies": [{"eq": ["e.horse_led_out.purpose", "injure"]}, {"ne": ["e.led_to_hollow.place", "stable"]}]}, "rules": [{"rule": "r.horse_would_wake_sleepers", "bind": {"outing": "e.horse_led_out", "leading": "e.led_to_hollow", "sleepers": "e.hunter_on_guard"}}], "asserted": "An explanation of why the horse had to be taken out at all, not a derivation: the rule needs the hollow event tied to the horse, which only the marks in the hollow give, and those already give the place. Cause and explanation are redesign step 3."},
    {"id": "k.horse_kicked", "label": "A light was struck beside the horse in the hollow, where no one could see it; a horse startled by a sudden glare, sensing mischief, lashes out. The head was shattered by a heavy blow, and the horse was there: the steel shoe killed him.", "by": "holmes", "premises": ["c.head_shattered", "c.horse_was_in_hollow", "c.vesta_in_mud", "r.startled_horse_kicks", "r.light_hidden_in_hollow", "r.hoof_strikes_as_horse_kicks"], "formula": {"and": [{"eq": ["e.fatal_blow.agent", "silver_blaze"]}, {"eq": ["e.fatal_blow.instrument", "steel_shoe"]}]}, "rules": [{"rule": "r.startled_horse_kicks", "bind": {"horse": "silver_blaze", "arrival": "e.led_to_hollow", "striking": "e.light_struck", "blow": "e.fatal_blow"}}, {"rule": "r.hoof_strikes_as_horse_kicks", "bind": {"shoe": "steel_shoe", "horse": "silver_blaze", "blow": "e.fatal_blow"}}]},
    {"id": "k.blow_needs_a_wielder", "label": "A heavy stick needs a hand to swing it; a horse's shoe strikes only as the horse kicks.", "by": "editorial", "premises": ["c.head_shattered", "r.hoof_strikes_as_horse_kicks", "r.stick_needs_a_hand"], "formula": {"and": [{"implies": [{"eq": ["e.fatal_blow.instrument", "steel_shoe"]}, {"eq": ["e.fatal_blow.agent", "silver_blaze"]}]}, {"implies": [{"eq": ["e.fatal_blow.agent", "silver_blaze"]}, {"eq": ["e.fatal_blow.instrument", "steel_shoe"]}]}, {"implies": [{"eq": ["e.fatal_blow.instrument", "penang_lawyer"]}, {"same": ["e.fatal_blow.agent", "penang_lawyer.owner"]}]}]}, "rules": [{"rule": "r.hoof_strikes_as_horse_kicks", "bind": {"shoe": "steel_shoe", "horse": "silver_blaze", "blow": "e.fatal_blow"}}, {"rule": "r.stick_needs_a_hand", "bind": {"stick": "penang_lawyer", "blow": "e.fatal_blow"}}]},
    {"id": "k.only_one_blade", "label": "Simpson had no knife and no other blade was found; Straker's own knife was bloody to the handle: the cut on his thigh was his own knife, as he fell.", "by": "watson", "premises": ["c.simpson_no_knife", "c.knife_in_right_hand", "c.thigh_cut", "c.head_shattered", "r.convulsions_after_brain_injury"], "formula": {"and": [{"eq": ["e.thigh_cut.instrument", "cataract_knife"]}, {"eq": ["e.thigh_cut.agent", "straker"]}]}, "rules": [{"rule": "r.convulsions_after_brain_injury", "bind": {"blow": "e.fatal_blow", "cut": "e.thigh_cut", "held": "cataract_knife"}}]},
    {"id": "k.knife_marks_assailant", "label": "If Straker's knife had cut an assailant, that man would bear a wound; Simpson has none.", "by": "holmes", "premises": ["c.knife_in_right_hand", "c.simpson_no_wound", "c.thigh_cut", "c.head_shattered", "r.knife_marks_assailant", "r.wounds_in_a_struggle"], "formula": {"implies": [{"eq": ["e.fatal_blow.agent", "simpson"]}, {"eq": ["e.thigh_cut.agent", "straker"]}]}, "stated": [{"by": "police", "source": ["one at least of his assailants must bear his mark upon him"]}], "rules": [{"rule": "r.knife_marks_assailant", "bind": {"blow": "e.fatal_blow", "cut": "e.thigh_cut", "man": "simpson"}}, {"rule": "r.wounds_in_a_struggle", "bind": {"blow": "e.fatal_blow", "cut": "e.thigh_cut"}}]},
    {"id": "k.cravat_order", "label": "The cravat was dropped before Straker came to hold it, and he held it before he died, after leaving home.", "by": "holmes", "premises": ["c.cravat_in_left_hand", "c.simpson_owns_cravat"], "formula": {"and": [{"same": ["e.cravat_dropped.agent", "cravat.owner"]}, {"not_after": ["e.cravat_dropped.time", "e.cravat_picked_up.time"]}, {"before": ["e.cravat_picked_up.time", "e.fatal_blow.time"]}, {"not_after": ["e.straker_leaves.time", "e.cravat_picked_up.time"]}, {"eq": ["e.cravat_dropped.object", "cravat"]}, {"eq": ["e.cravat_picked_up.object", "cravat"]}]}},
    {"id": "k.cravat_worn_at_window", "label": "The stranger was wearing the cravat when the maid saw him at the stable, so he lost it no earlier than that.", "by": "editorial", "premises": ["c.edith_knows_cravat", "c.stranger_leaning_in"], "formula": {"not_after": [{"lit": "w.mon_2110"}, "e.cravat_dropped.time"]}},
    {"id": "k.simpson_purpose", "label": "Simpson came either for information, or to drug the guard, or to steal the horse; each of the last two would make him the drugger or the thief.", "by": "police", "premises": ["c.simpson_admits_visit"], "formula": {"and": [{"implies": [{"eq": ["simpson.purpose", "nobble_horse"]}, {"eq": ["e.opium_added.agent", "simpson"]}]}, {"implies": [{"eq": ["simpson.purpose", "steal_horse"]}, {"eq": ["e.horse_led_out.agent", "simpson"]}]}]}},
    {"id": "k.paper_held_opium_means_nobbling", "label": "Had the folded paper held opium, his purpose was to drug the boy.", "by": "police", "premises": ["c.bribe_to_edith", "c.paper_in_hand"], "formula": {"implies": [{"eq": ["paper_packet.contents", "opium"]}, {"eq": ["simpson.purpose", "nobble_horse"]}]}},
    {"id": "k.bill_is_his_own", "label": "Men do not carry other people's bills: the milliner's account in Straker's pocket was his own.", "by": "holmes", "premises": ["c.milliner_bill", "c.papers_in_pocket", "r.others_bills"], "formula": {"eq": ["milliner_bill.owner", "straker"]}, "rules": [{"rule": "r.others_bills", "bind": {"doc": "milliner_bill"}}]},
    {"id": "k.bill_names_its_debtor", "label": "The account is made out to William Derbyshire: whoever really owes it is 'Derbyshire'.", "by": "holmes", "premises": ["c.milliner_bill"], "formula": {"same": ["milliner_bill.owner", "william_derbyshire.identity"]}},
    {"id": "k.second_household", "label": "A trainer's wages do not buy twenty-guinea dresses, and his wife never had one: 'Derbyshire' was keeping a second establishment, and its cost drove him into debt. If Derbyshire is Straker, that is Straker's motive.", "by": "holmes", "premises": ["c.milliner_bill", "c.bill_22_guineas", "c.wife_never_had_dress", "r.servant_wages", "r.second_establishment", "r.laying_against"], "formula": {"implies": [{"eq": ["william_derbyshire.identity", "straker"]}, {"and": [{"eq": ["e.second_household.agent", "straker"]}, {"eq": ["e.straker_in_debt.patient", "straker"]}, {"eq": ["straker.motive", "debts_of_second_household"]}, {"not_after": ["e.second_household.time", "e.dresses_bought.time"]}]}]}, "rules": [{"rule": "r.servant_wages", "bind": {"buyer": "straker", "buying": "e.dresses_bought", "debt": "e.straker_in_debt"}}, {"rule": "r.second_establishment", "bind": {"buyer": "straker", "wife": "mrs_straker", "buying": "e.dresses_bought", "household": "e.second_household"}}]},
    {"id": "k.dresses_for_the_other_woman", "label": "The dresses were bought for a woman who is neither the wife nor anyone else in the household.", "by": "holmes", "premises": ["c.wife_never_had_dress", "c.bill_22_guineas", "r.no_finery_for_servants"], "formula": {"nin": ["e.dresses_bought.recipient", ["mrs_straker", "edith_baxter"]]}, "stated": [{"by": "holmes", "source": ["twenty-guinea walking dresses for their ladies"]}], "rules": [{"rule": "r.no_finery_for_servants", "bind": {"buying": "e.dresses_bought", "servant": "edith_baxter"}}]},
    {"id": "k.practice_first", "label": "So delicate an operation is not attempted without practice; three of the paddock sheep have lately gone lame: Straker practised on them. The lameness is recent ('of late').", "by": "holmes", "premises": ["c.sheep_lame", "r.practise_first", "r.tendon_nick"], "formula": {"implies": [{"eq": ["e.horse_led_out.purpose", "injure"]}, {"and": [{"same": ["e.practice_on_sheep.agent", "e.horse_led_out.agent"]}, {"eq": ["e.practice_on_sheep.patient", "lame_sheep"]}, {"eq": ["e.practice_on_sheep.place", "paddock"]}, {"in": ["e.practice_on_sheep.time", ["w.weeks_before", "w.mon_day"]]}]}]}, "rules": [{"rule": "r.practise_first", "bind": {"outing": "e.horse_led_out", "practice": "e.practice_on_sheep", "plot": "e.plot_to_lame"}}]},
    {"id": "k.lame_plan", "label": "Whoever took the horse out to lame it had plotted to lame it beforehand.", "by": "holmes", "premises": ["c.stall_empty", "c.sheep_lame", "r.tendon_nick", "r.laying_against", "r.practise_first"], "formula": {"implies": [{"eq": ["e.horse_led_out.purpose", "injure"]}, {"and": [{"same": ["e.plot_to_lame.agent", "e.horse_led_out.agent"]}, {"eq": ["e.plot_to_lame.patient", "silver_blaze"]}, {"same": ["e.lays_against.agent", "e.horse_led_out.agent"]}, {"not_after": ["e.plot_to_lame.time", "e.practice_on_sheep.time"]}, {"before": ["e.lays_against.time", "e.horse_led_out.time"]}]}]}, "rules": [{"rule": "r.laying_against", "bind": {"outing": "e.horse_led_out", "plot": "e.plot_to_lame", "laying": "e.lays_against"}}, {"rule": "r.practise_first", "bind": {"outing": "e.horse_led_out", "practice": "e.practice_on_sheep", "plot": "e.plot_to_lame"}}]},
    {"id": "k.horse_goes_home", "label": "A loose horse goes back to its own stable or to the nearest other one; gypsies would not take it, for they flee trouble and could never sell it. It is not at King's Pyland: so it went to Mapleton.", "by": "holmes", "premises": ["r.horse_gregarious", "r.gypsies_avoid_trouble", "r.famous_horse_unsellable", "c.gypsies_gone", "c.no_news_of_horse", "c.stall_empty"], "formula": {"and": [{"in": ["silver_blaze.hidden_at", ["kings_pyland", "mapleton"]]}, {"ne": ["e.horse_hidden.agent", "gypsies"]}]}, "rules": [{"rule": "r.horse_gregarious", "bind": {"horse": "silver_blaze", "home": "kings_pyland", "nearest": "mapleton", "loose": "e.horse_led_out"}}, {"rule": "r.gypsies_avoid_trouble", "bind": {"band": "gypsies", "leaving": "e.gypsies_leave", "hiding": "e.horse_hidden"}}]},
    {"id": "k.tracks_end_at_mapleton", "label": "The horse's track, with a man's beside it, ends at the Mapleton gates: the horse is there.", "by": "holmes", "premises": ["c.horse_track_in_wet_hollow", "c.double_track_loops", "r.tracks_lead_in"], "formula": {"and": [{"eq": ["silver_blaze.hidden_at", "mapleton"]}, {"eq": ["e.horse_hidden.place", "mapleton"]}]}, "rules": [{"rule": "r.tracks_lead_in", "bind": {"track": "e.brown_turns_back", "hiding": "e.horse_hidden", "horse": "silver_blaze", "stable": "mapleton"}}]},
    {"id": "k.boots_identify", "label": "The square-toed prints match Silas Brown's own boots: he is the man.", "by": "holmes", "premises": ["c.square_toes", "r.prints_identify_boots"], "formula": {"same": ["track_man.identity", "brown_boots.owner"]}, "rules": [{"rule": "r.prints_identify_boots", "bind": {"walker": "track_man", "boots": "brown_boots"}}]},
    {"id": "k.first_up_and_no_subordinate", "label": "Brown is always first up, and no subordinate would dare: if the horse went into Mapleton at dawn, it was Brown who took it in.", "by": "holmes", "premises": ["c.brown_first_up", "c.no_subordinate", "c.dawson_fears_master", "c.mapleton_brown", "r.first_up_takes_it_in"], "formula": {"implies": [{"eq": ["e.horse_hidden.place", "mapleton"]}, {"eq": ["e.horse_hidden.agent", "silas_brown"]}]}, "rules": [{"rule": "r.first_up_takes_it_in", "bind": {"stable": "mapleton", "master": "silas_brown", "hiding": "e.horse_hidden"}}]},
    {"id": "k.brown_broke", "label": "Brown gave in to Holmes: 'Your instructions will be done … It shall be there.' He has the horse.", "by": "watson", "premises": ["c.brown_capitulates", "r.undertaking_means_possession"], "formula": {"eq": ["e.horse_hidden.agent", "silas_brown"]}, "rules": [{"rule": "r.undertaking_means_possession", "bind": {"promise": "e.brown_agrees", "hiding": "e.horse_hidden"}}]},
    {"id": "k.found_at_dawn", "label": "Brown is always first stirring: he met the loose horse at dawn, and led it in then.", "by": "holmes", "premises": ["c.brown_first_up", "c.horse_alone"], "formula": {"and": [{"eq": ["e.brown_finds_horse.time", "w.tue_dawn"]}, {"eq": ["e.brown_turns_back.time", "w.tue_dawn"]}, {"eq": ["e.horse_hidden.time", "w.tue_dawn"]}]}, "asserted": "The hour is Holmes's reconstruction (the first man stirring, at five), told only as his account at s07 (c.brown_story_told); no earlier claim gives it."},
    {"id": "k.disguised_to_survive_search", "label": "The police searched Mapleton and found nothing, though the horse was there and 'a child would know' him: his markings must have been hidden — a horse-faker's trick.", "by": "holmes", "premises": ["c.mapleton_searched_nothing", "c.silver_blaze_markings", "r.disguise_washes_off"], "formula": {"implies": [{"eq": ["silver_blaze.hidden_at", "mapleton"]}, {"and": [{"eq": ["silver_blaze.disguised", "true"]}, {"same": ["e.horse_disguised.agent", "e.horse_hidden.agent"]}, {"eq": ["e.horse_disguised.patient", "silver_blaze"]}, {"eq": ["e.horse_disguised.instrument", "disguise_dye"]}, {"eq": ["e.horse_disguised.place", "mapleton"]}]}]}},
    {"id": "k.markings_identify", "label": "Silver Blaze has a white forehead and a mottled leg; the bay has not a white hair — so, unless the markings are hidden, the bay is not Silver Blaze.", "by": "colonel_ross", "premises": ["c.silver_blaze_markings", "c.bay_no_white", "r.markings_identify_horse"], "formula": {"implies": [{"eq": ["silver_blaze.disguised", "false"]}, {"ne": ["the_bay.identity", "silver_blaze"]}]}, "stated": [{"by": "colonel_ross", "source": ["That beast has not a white hair upon its body"]}]},
    {"id": "k.bay_is_ross_entry", "label": "The bay carries Ross's colours; all six numbers are up, Bayard is scratched, and no other Ross horse is entered: the bay is Ross's runner, Silver Blaze.", "by": "holmes", "premises": ["c.bay_in_ross_colours", "c.race_card", "c.all_six_there", "c.bayard_scratched", "r.colours_identify_owner"], "formula": {"eq": ["the_bay.identity", "silver_blaze"]}},
    {"id": "k.sent_over_by_hider", "label": "The horse came to the course from whoever was hiding it.", "by": "holmes", "premises": ["c.found_with_faker", "c.brown_capitulates"], "formula": {"same": ["e.horse_sent_over.agent", "e.horse_hidden.agent"]}, "stated": [{"by": "holmes", "source": ["took the liberty of running him just as he was sent over"]}]},
    {"id": "k.went_out_to_the_stables", "label": "If Straker took the horse, he picked up his knife as he left and went down to the stable.", "by": "editorial", "premises": ["c.straker_dressing_at_one", "c.knife_from_dressing_table"], "formula": {"implies": [{"eq": ["e.horse_led_out.agent", "straker"]}, {"eq": ["e.stable_entered.agent", "straker"]}]}},
    {"id": "k.police_simpson_drugged", "label": "The stranger at the window was Simpson, and he drugged the lad's supper as he stood there.", "by": "police", "truth": false, "premises": ["c.hunter_blames_stranger", "c.stranger_leaning_in"], "formula": {"eq": ["e.opium_added.agent", "simpson"]}, "stated": [{"by": "police", "source": ["this Fitzroy Simpson, having drugged the lad"]}]},
    {"id": "k.police_simpson_took_horse", "label": "Simpson came back in the night, took the horse out of the stable and led it off, meaning to steal it.", "by": "police", "truth": false, "premises": ["c.stranger_asked_for_tip", "c.bridle_missing", "c.stall_empty"], "formula": {"and": [{"eq": ["e.horse_led_out.agent", "simpson"]}, {"eq": ["e.horse_led_out.purpose", "steal"]}, {"eq": ["simpson.purpose", "steal_horse"]}]}, "stated": [{"by": "police", "source": ["with the intention, apparently, of kidnapping him altogether"]}]},
    {"id": "k.police_stick_killed", "label": "Simpson's lead-weighted stick is just such a weapon as made the wounds: Simpson struck the fatal blow with it.", "by": "police", "truth": false, "premises": ["c.simpson_stick", "c.head_shattered", "c.cravat_in_left_hand"], "formula": {"and": [{"eq": ["e.fatal_blow.agent", "simpson"]}, {"eq": ["e.fatal_blow.instrument", "penang_lawyer"]}]}, "stated": [{"by": "police", "source": ["just such a weapon as might, by repeated blows, have inflicted the terrible injuries"]}]},
    {"id": "k.gregory_gypsies", "label": "The gypsies camped near the hollow on Monday night and were gone on Tuesday: Simpson was leading the horse to them, and they have it now.", "by": "gregory", "truth": false, "premises": ["c.gypsies_camped", "c.gypsies_gone"], "formula": {"and": [{"eq": ["e.horse_hidden.agent", "gypsies"]}, {"eq": ["silver_blaze.hidden_at", "gypsy_camp"]}]}, "stated": [{"by": "gregory", "source": ["might he\n      not have been leading the horse to them when he was overtaken"]}]}
